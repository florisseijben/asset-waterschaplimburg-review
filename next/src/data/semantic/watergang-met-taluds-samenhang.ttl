@prefix object: <https://data.waterschaplimburg.nl/id/objecttype/> .
@prefix relatie: <https://data.waterschaplimburg.nl/def/relatie/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

object:watergang a owl:Class ;
  rdfs:label "Watergang" .

object:watergangsectie a owl:Class ;
  rdfs:label "Watergangsectie" .

object:watergang-met-taluds a owl:Class ;
  rdfs:label "Watergang met taluds" .

object:talud a owl:Class ;
  rdfs:label "Talud" .

object:bodem a owl:Class ;
  rdfs:label "Bodem" .

relatie:heeftSectie a owl:ObjectProperty ;
  rdfs:label "Heeft sectie" .

relatie:heeftType a owl:ObjectProperty ;
  rdfs:label "Heeft type" .

relatie:heeftTalud a owl:ObjectProperty ;
  rdfs:label "Heeft talud" .

relatie:heeftBodem a owl:ObjectProperty ;
  rdfs:label "Heeft bodem" .

object:watergang relatie:heeftSectie object:watergangsectie .
object:watergangsectie relatie:heeftType object:watergang-met-taluds .
object:watergang-met-taluds relatie:heeftTalud object:talud .
object:watergang-met-taluds relatie:heeftBodem object:bodem .

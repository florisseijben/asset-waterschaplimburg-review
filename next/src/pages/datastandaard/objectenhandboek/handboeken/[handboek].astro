---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import Hero from "../../../../components/Hero.astro";
import PrintPageAction from "../../../../components/PrintPageAction.astro";
import { getCollection } from "astro:content";
import {
  getObjectHandbookHref,
  getObjectHandbookId,
  handbookScopes
} from "../../../../lib/objectenhandboekHandbooks";
import { createObjectBreadcrumbs } from "../../../../lib/objectenhandboekBreadcrumbs";
import { objectenhandboekTaxonomy } from "../../../../lib/objectenhandboekTaxonomy";
import { withBase } from "../../../../lib/paths";
import { normalizeObjectUitwerkingSections } from "../../../../lib/uitwerkingSections";
import { getDecompositionFromAssetJson } from "../../../../lib/assetConcepts";

export async function getStaticPaths() {
  const objectEntries = await getCollection("datastandaard-objectenhandboek-objects");
  const objectScopes = objectEntries.map((entry) => ({
    id: getObjectHandbookId(entry.id),
    kind: "object" as const,
    label: entry.data.heroTitle || entry.data.title,
    href: getObjectHandbookHref(entry.id),
    landingHref: entry.data.slug,
    objectEntryId: entry.id,
    summary: `Printbare versie van ${entry.data.heroTitle || entry.data.title}, opgebouwd uit definitie, begrip en inhoudelijke uitwerking.`
  }));

  return [...handbookScopes, ...objectScopes].map((scope) => ({
    params: { handboek: scope.id },
    props: { scope }
  }));
}

const { scope } = Astro.props;
const entries = await getCollection("datastandaard-objectenhandboek-objects");
const collator = new Intl.Collator("nl", { numeric: true, sensitivity: "base" });
const systemHierarchyLabels = new Set([
  "afvalwaterketen",
  "waterketen",
  "watersysteem",
  "waterkeringensysteem",
  "waterkeringen"
]);

const normalizeKey = (value: string) =>
  String(value || "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

const getObjectTitle = (entry: any) => entry.data.heroTitle || entry.data.title;
const chapterLabelsByRoot = new Map([
  ["kunstwerk", "Kunstwerken"],
  ["kunstwerken", "Kunstwerken"],
  ["regenwaterbuffer", "Regenwaterbuffers"],
  ["regenwaterbuffers", "Regenwaterbuffers"],
  ["stroomgebied", "Stroomgebieden"],
  ["stroomgebieden", "Stroomgebieden"],
  ["watergang", "Watergangen"],
  ["watergangen", "Watergangen"],
  ["watergangsectie", "Watergangen"],
  ["intersectie", "Watergangen"]
]);
const objectFamilyLabelById = new Map(
  objectenhandboekTaxonomy.objectFamilies.map((family) => [family.id, family.label])
);

const belongsToClassificationScope = (entry: any) => {
  const classification = entry.data.classification || {};

  if (scope.kind === "all") {
    return true;
  }

  const values = scope.kind === "system" ? classification.systems : classification.disciplines;

  return Array.isArray(values) && values.includes(scope.id);
};

const createHandbookPath = (entry: any) => {
  const title = getObjectTitle(entry);
  let path = Array.isArray(entry.data.hierarchy) && entry.data.hierarchy.length > 0
    ? entry.data.hierarchy.map(String)
    : [title];

  if (path.length > 1 && systemHierarchyLabels.has(normalizeKey(path[0]))) {
    path = path.slice(1);
  }

  if (path.length > 1 && normalizeKey(path[0]) === "stroomgebied") {
    path = path.slice(1);
  }

  if (!path.some((item) => normalizeKey(item) === normalizeKey(title))) {
    path = [...path, title];
  }

  return path.length ? path : [title];
};

const getPrimaryObjectFamilyLabel = (entry: any) => {
  const objectFamilyId = entry.data.classification?.objectFamilies?.[0];

  return objectFamilyLabelById.get(objectFamilyId) || "Overige objecttypen";
};

const getChapterLabel = (path: string[], entry: any) => {
  const root = normalizeKey(path[0] || getObjectTitle(entry));

  return chapterLabelsByRoot.get(root) || getPrimaryObjectFamilyLabel(entry);
};

type HandbookNode = {
  title: string;
  path: string[];
  entry?: any;
  summary?: string;
  text?: string;
  sections: any[];
  children: HandbookNode[];
};

function getOrCreateNode(nodes: HandbookNode[], title: string, path: string[]) {
  const key = normalizeKey(title);
  const existing = nodes.find((node) => normalizeKey(node.title) === key);

  if (existing) {
    return existing;
  }

  const node: HandbookNode = {
    title,
    path,
    sections: [],
    children: []
  };

  nodes.push(node);
  return node;
}

function insertNode(nodes: HandbookNode[], path: string[], payload: Partial<HandbookNode>) {
  let currentNodes = nodes;
  let node: HandbookNode | undefined;

  path.forEach((title, index) => {
    node = getOrCreateNode(currentNodes, title, path.slice(0, index + 1));
    currentNodes = node.children;
  });

  if (!node) {
    return;
  }

  node.entry = payload.entry || node.entry;
  node.summary = payload.summary || node.summary;
  node.text = payload.text || node.text;
  node.sections = payload.sections || node.sections;
}

const getNodeSortRank = (title: string) => {
  const key = normalizeKey(title);

  if (key === "typen") {
    return 0;
  }

  if (key === "onderdelen") {
    return 1;
  }

  return 2;
};

function sortNodes(nodes: HandbookNode[]) {
  nodes.sort(
    (left, right) =>
      getNodeSortRank(left.title) - getNodeSortRank(right.title) ||
      collator.compare(left.title, right.title)
  );
  nodes.forEach((node) => sortNodes(node.children));
}

function flattenNodes(nodes: HandbookNode[], prefix: number[] = [], depth = 1, startIndex = 0): any[] {
  return nodes.flatMap((node, index) => {
    const numberParts = [...prefix, startIndex + index + 1];
    const numberedNode = {
      ...node,
      depth,
      number: numberParts.join("."),
      id: `${numberParts.join("-")}-${normalizeKey(node.path.join("-"))}`
    };

    return [numberedNode, ...flattenNodes(node.children, numberParts, depth + 1)];
  });
}

function createTocRows(items: any[], collapseDepth: number) {
  const rows = [];

  for (let index = 0; index < items.length; index += 1) {
    const item = items[index];
    const descendants = [];

    if (item.depth === collapseDepth) {
      let descendantIndex = index + 1;

      while (descendantIndex < items.length && items[descendantIndex].depth > item.depth) {
        descendants.push(items[descendantIndex]);
        descendantIndex += 1;
      }

      if (descendants.length > 0) {
        rows.push({
          item,
          descendants,
          isCollapsible: true
        });
        index = descendantIndex - 1;
        continue;
      }
    }

    rows.push({
      item,
      descendants: [],
      isCollapsible: false
    });
  }

  return rows;
}

const allEntryByTitleKey = new Map(entries.map((entry) => [normalizeKey(getObjectTitle(entry)), entry]));
const normalizeHrefKey = (value = "") =>
  String(value || "")
    .split(/[?#]/)[0]
    .replace(/\/+$/g, "");
const allEntryByHrefKey = new Map(
  entries
    .map((entry) => [normalizeHrefKey(entry.data.slug), entry])
    .filter(([href]) => href)
);
const chapterMap = new Map<string, { label: string; nodes: HandbookNode[] }>();

const getOnderdeelItems = (entry: any) =>
  (entry.data.contentSections || []).find((section: any) => normalizeKey(section.title) === "onderdelen")?.items || [];

const getObjectEntryForItem = (item: any) =>
  allEntryByTitleKey.get(normalizeKey(item?.title)) ||
  allEntryByHrefKey.get(normalizeHrefKey(item?.href));

const uniqueChildItems = (items: any[]) => {
  const seen = new Set<string>();

  return items.filter((item) => {
    const key = normalizeKey(item.title);

    if (!key || seen.has(key)) {
      return false;
    }

    seen.add(key);
    return true;
  });
};

const getPrintChildItems = (entry: any) => {
  const decomposition = getDecompositionFromAssetJson(getObjectTitle(entry));

  return uniqueChildItems([
    ...getOnderdeelItems(entry).filter((item: any) => getObjectEntryForItem(item)),
    ...(entry.data.compositionTypes || []),
    ...(decomposition?.items || []).filter((item: any) => getObjectEntryForItem(item))
  ]);
};

const getDirectChildTitleKeys = (entry: any) => {
  const titleKeys = getPrintChildItems(entry)
    .map((item: any) => normalizeKey(item.title))
    .filter(Boolean);

  return new Set(titleKeys);
};

const createDecompositionSectionForPrint = (entry: any) => {
  const childItems = getPrintChildItems(entry);

  if (!childItems.length) {
    return undefined;
  }

  return {
    title: "Decompositie",
    summary: "De decompositie toont de eerstvolgende onderliggende objecten die onder dit object als eigen paragraaf worden uitgewerkt.",
    items: childItems.map((item: any) => {
      const childEntry = getObjectEntryForItem(item);

      return {
        title: childEntry ? getObjectTitle(childEntry) : item.title,
        text: item.text || childEntry?.data.summary || "",
        href: childEntry?.data.slug || item.href,
        iconTitle: getObjectTitle(entry)
      };
    })
  };
};

const scopeRootEntry = scope.kind === "object"
  ? entries.find((entry) => entry.id === scope.objectEntryId)
  : undefined;
const scopeRootPath = scopeRootEntry ? createHandbookPath(scopeRootEntry) : [];
const scopeRootChildTitleKeys = scopeRootEntry ? getDirectChildTitleKeys(scopeRootEntry) : new Set<string>();

const isDirectChildOfScopeRoot = (entry: any) => {
  if (!scopeRootEntry || entry.id === scopeRootEntry.id) {
    return false;
  }

  const path = createHandbookPath(entry);
  const isDirectPathChild =
    path.length === scopeRootPath.length + 1 &&
    scopeRootPath.every((title, index) => normalizeKey(title) === normalizeKey(path[index]));

  return isDirectPathChild || scopeRootChildTitleKeys.has(normalizeKey(getObjectTitle(entry)));
};

const belongsToObjectScope = (entry: any) =>
  scope.kind === "object" &&
  (entry.id === scope.objectEntryId || isDirectChildOfScopeRoot(entry));

const isCompositionTypeOfParent = (parentEntry: any, childTitle: string) =>
  (parentEntry.data.compositionTypes || []).some(
    (compositionType: any) => normalizeKey(compositionType.title) === normalizeKey(childTitle)
  );

const isCompositionTypeParagraph = (entry: any) => {
  if (scope.kind === "object" && entry.id === scope.objectEntryId) {
    return false;
  }

  const path = createHandbookPath(entry);

  if (path.length < 2) {
    return false;
  }

  const parentEntry = allEntryByTitleKey.get(normalizeKey(path[path.length - 2]));

  return parentEntry ? isCompositionTypeOfParent(parentEntry, getObjectTitle(entry)) : false;
};

const isAllowedInHandbookTree = (entry: any) => {
  const path = createHandbookPath(entry);

  return path.every((title, index) => {
    if (index === 0) {
      return true;
    }

    const parentEntry = allEntryByTitleKey.get(normalizeKey(path[index - 1]));

    if (!parentEntry || !(parentEntry.data.compositionTypes || []).length) {
      return true;
    }

    return isCompositionTypeOfParent(parentEntry, title);
  });
};

const scopedEntries = entries.filter(
  (entry) =>
    (scope.kind === "object" ? belongsToObjectScope(entry) : belongsToClassificationScope(entry)) &&
    isAllowedInHandbookTree(entry)
);

const createCategorizedPath = (entry: any) => {
  const path = createHandbookPath(entry);

  if (scope.kind !== "object" || !scopeRootEntry || entry.id === scopeRootEntry.id) {
    return path;
  }

  const isDirectPathChild =
    path.length === scopeRootPath.length + 1 &&
    scopeRootPath.every((title, index) => normalizeKey(title) === normalizeKey(path[index]));

  if (!isDirectPathChild && scopeRootChildTitleKeys.has(normalizeKey(getObjectTitle(entry)))) {
    return [...scopeRootPath, getObjectTitle(entry)];
  }

  return path;
};

type PrintSectionOptions = {
  excludeOverviewSamenhang?: boolean;
  includeDecompositionOverview?: boolean;
};

const isHighestPrintLevelEntry = (entry: any, path: string[]) => {
  if (scope.kind === "object") {
    return entry.id === scope.objectEntryId;
  }

  return path.length === 1;
};

const insertDecompositionSection = (sections: any[], decompositionSection: any) => {
  if (!decompositionSection) {
    return sections;
  }

  const overviewIndex = sections.findIndex((section: any) => normalizeKey(section.title) === "overzicht-samenhang");

  if (overviewIndex < 0) {
    return [decompositionSection, ...sections];
  }

  return [
    ...sections.slice(0, overviewIndex + 1),
    decompositionSection,
    ...sections.slice(overviewIndex + 1)
  ];
};

const getContentSectionsForPrint = (entry: any, options: PrintSectionOptions = {}) => {
  const childTitleKeys = getDirectChildTitleKeys(entry);
  const decompositionSection = options.includeDecompositionOverview
    ? createDecompositionSectionForPrint(entry)
    : undefined;

  const sections = (entry.data.contentSections || [])
    .filter((section: any) => {
      const sectionKey = normalizeKey(section.title);

      if (options.excludeOverviewSamenhang && sectionKey === "overzicht-samenhang") {
        return false;
      }

      return sectionKey !== "typen" && sectionKey !== "decompositie";
    })
    .map((section: any) => {
      if (normalizeKey(section.title) !== "onderdelen" || !(section.items || []).length) {
        return section;
      }

      const remainingItems = section.items.filter(
        (item: any) => !childTitleKeys.has(normalizeKey(item.title))
      );

      return remainingItems.length
        ? {
            ...section,
            items: remainingItems
          }
        : undefined;
    })
    .filter(Boolean);

  return insertDecompositionSection(sections, decompositionSection);
};

const getPrintableSections = (entry: any, options: PrintSectionOptions = {}) =>
  normalizeObjectUitwerkingSections(getContentSectionsForPrint(entry, options), {
    compositionTypes: [],
    subtypeIconTitle: getObjectTitle(entry),
    includeTypen: false,
    includeOnderdelenWithCompositionTypes: true,
    includeDecomposition: options.includeDecompositionOverview,
    requireStandardSections: false,
    excludeTitles: options.includeDecompositionOverview ? ["Typen"] : ["Decompositie", "Typen"]
  });

const scopedEntryIds = new Set(scopedEntries.map((entry) => entry.id));
const printPathByEntryId = new Map<string, string[]>();

scopedEntries.forEach((entry) => {
  const categorizedPath = createCategorizedPath(entry);
  const chapterLabel = getChapterLabel(categorizedPath, entry);
  const chapter = chapterMap.get(chapterLabel) || { label: chapterLabel, nodes: [] };
  printPathByEntryId.set(entry.id, categorizedPath);
  insertNode(chapter.nodes, categorizedPath, {
    entry,
    title: getObjectTitle(entry),
    path: categorizedPath,
    summary: entry.data.summary,
    sections: getPrintableSections(entry, {
      excludeOverviewSamenhang: isCompositionTypeParagraph(entry),
      includeDecompositionOverview: isHighestPrintLevelEntry(entry, categorizedPath)
    })
  });

  chapterMap.set(chapterLabel, chapter);
});

const entryQueue = [...scopedEntries];

for (let entryIndex = 0; entryIndex < entryQueue.length; entryIndex += 1) {
  const entry = entryQueue[entryIndex];
  const childItems = getPrintChildItems(entry);

  if (!childItems.length) {
    continue;
  }

  const parentPath = printPathByEntryId.get(entry.id) || createCategorizedPath(entry);
  const chapterLabel = getChapterLabel(parentPath, entry);
  const chapter = chapterMap.get(chapterLabel);

  if (!chapter) {
    continue;
  }

  childItems.forEach((childItem: any) => {
    const childEntry = getObjectEntryForItem(childItem);

    if (childEntry && scopedEntryIds.has(childEntry.id)) {
      return;
    }

    if (childEntry && (scope.kind === "object" || belongsToClassificationScope(childEntry))) {
      const childPath = createCategorizedPath(childEntry);
      const childPathIsBelowParent =
        childPath.length > parentPath.length &&
        parentPath.every((title, index) => normalizeKey(title) === normalizeKey(childPath[index]));
      const printChildPath = childPathIsBelowParent ? childPath : [...parentPath, getObjectTitle(childEntry)];

      insertNode(chapter.nodes, printChildPath, {
        entry: childEntry,
        summary: childEntry.data.summary,
        sections: getPrintableSections(childEntry, {
          excludeOverviewSamenhang: isCompositionTypeOfParent(entry, getObjectTitle(childEntry))
        })
      });
      printPathByEntryId.set(childEntry.id, printChildPath);
      scopedEntryIds.add(childEntry.id);
      entryQueue.push(childEntry);
      return;
    }

    if (isCompositionTypeOfParent(entry, childItem.title)) {
      insertNode(chapter.nodes, [...parentPath, childItem.title], {
        summary: childItem.text,
        text: childItem.text
      });
    }
  });
}

const handbookChapters = [...chapterMap.values()]
  .map((chapter) => {
    sortNodes(chapter.nodes);

    return chapter;
  })
  .sort((left, right) => collator.compare(left.label, right.label))
  .map((chapter, index) => {
    const promotedRoot = chapter.nodes.length === 1 && chapter.nodes[0].children.length > 0
      ? chapter.nodes[0]
      : undefined;
    const introNode = promotedRoot?.entry ? promotedRoot : undefined;
    const printableNodes = promotedRoot ? promotedRoot.children : chapter.nodes;
    const introNumber = introNode ? String(index + 1) : undefined;
    const introId = introNode ? `${index + 1}-${normalizeKey(introNode.path.join("-"))}` : undefined;
    const flatNodes = flattenNodes(printableNodes, [index + 1], introNode ? 2 : 1, 0);
    const tocIntroNode = introNode && introNumber
      ? [{ ...introNode, depth: 1, number: introNumber, id: introId }]
      : [];
    const tocNodes = [...tocIntroNode, ...flatNodes];

    return {
      ...chapter,
      introNode,
      introNumber,
      introId,
      nodes: printableNodes,
      number: String(index + 1),
      id: normalizeKey(chapter.label),
      flatNodes,
      tocNodes,
      tocRows: createTocRows(tocNodes, introNode ? 2 : 1)
    };
  });

const handbookItemCount = handbookChapters.reduce((count, chapter) => count + chapter.flatNodes.length, 0);

const handbookTitle = scope.kind === "all" ? "Objectenhandboek" : `Objectenhandboek ${scope.label}`;
const handbookSummary = `${scope.summary} De digitale samenhangsweergaven, productlijn en vervolgstappen zijn in deze printversie weggelaten.`;
const defaultHandbookBreadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Datastandaard", href: "/datastandaard" },
  { label: "Objectenhandboek", href: "/datastandaard/objectenhandboek" },
  ...(scope.kind === "all" ? [] : [{ label: scope.label, href: scope.landingHref }])
];
const handbookBreadcrumbs = [
  ...(scope.kind === "object" && scopeRootEntry
    ? createObjectBreadcrumbs(scopeRootEntry, { includeCurrentHref: true })
    : defaultHandbookBreadcrumbs),
  { label: "Printbare versie" }
];
---

<BaseLayout
  title={handbookTitle}
  currentPath="/datastandaard"
  breadcrumbs={handbookBreadcrumbs}
>
  <Hero eyebrow="Printbare versie" title={handbookTitle} summary={handbookSummary} />

  <PrintPageAction label="Print handboek of maak PDF" />

  {handbookItemCount === 0 ? (
    <section class="section section-panel">
      <p class="eyebrow">Nog geen objecttypen</p>
      <h2>Deze bundel is nog leeg</h2>
      <p class="content-copy">
        Er zijn nog geen objecttypepagina's met deze classificatie. Zodra objecten aan deze ingang worden gekoppeld,
        verschijnen ze automatisch in dit printbare handboek.
      </p>
    </section>
  ) : (
    <div class="handbook-document">
      <aside class="section-panel handbook-toc" aria-label="Inhoudsopgave">
        <p class="eyebrow">Inhoud</p>
        <h2>Inhoudsopgave</h2>
        <ol class="handbook-toc__chapters">
          {handbookChapters.map((chapter) => (
            <li class="handbook-toc__chapter">
              <details class="handbook-toc__details" open>
                <summary class:list={["handbook-toc__summary", chapter.introNode && "handbook-toc__summary--group"]}>
                  {!chapter.introNode && <span class="handbook-number">{chapter.number}</span>}
                  <a
                    class="handbook-toc__chapter-link"
                    href={`#${chapter.id}`}
                    onclick="event.stopPropagation()"
                  >
                    {chapter.label}
                  </a>
                </summary>
                <ol class="handbook-toc__sections">
                  {chapter.tocRows.map((tocRow: any) => (
                    <li
                      class="handbook-toc__section"
                      style={`--handbook-level: ${Math.max(tocRow.item.depth - 1, 0)};`}
                    >
                      {tocRow.isCollapsible ? (
                        <details class="handbook-toc__subdetails">
                          <summary class="handbook-toc__subsummary">
                            <a
                              class="handbook-toc__subsummary-link"
                              href={`#${tocRow.item.id}`}
                              onclick="event.stopPropagation()"
                            >
                              <span class="handbook-number">{tocRow.item.number}</span>
                              <span>{tocRow.item.title}</span>
                            </a>
                          </summary>
                          <ol class="handbook-toc__subitems">
                            {tocRow.descendants.map((descendant: any) => (
                              <li
                                class="handbook-toc__subitem"
                                style={`--handbook-level: ${Math.max(descendant.depth - tocRow.item.depth - 1, 0)};`}
                              >
                                <a class="handbook-toc__link" href={`#${descendant.id}`}>
                                  <span class="handbook-number">{descendant.number}</span>
                                  <span>{descendant.title}</span>
                                </a>
                              </li>
                            ))}
                          </ol>
                        </details>
                      ) : (
                        <a class="handbook-toc__link" href={`#${tocRow.item.id}`}>
                          <span class="handbook-number">{tocRow.item.number}</span>
                          <span>{tocRow.item.title}</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ol>
              </details>
            </li>
          ))}
        </ol>
      </aside>

      <div class="handbook-content">
        {handbookChapters.map((chapter) => (
          <section class="section handbook-chapter" id={chapter.id}>
            <header class="section-panel handbook-chapter__heading">
              <p class="eyebrow">{chapter.introNode ? "Objectgroep" : `Hoofdstuk ${chapter.number}`}</p>
              <h2>
                {!chapter.introNode && <span class="handbook-number">{chapter.number}</span>}
                <span>{chapter.label}</span>
              </h2>
              {chapter.introNode && (
                <div class="handbook-chapter__intro">
                  {chapter.introNumber && (
                    <h3 class="handbook-object__numbered-heading" id={chapter.introId}>
                      <span class="handbook-number">{chapter.introNumber}</span>
                      <span>{chapter.introNode.title}</span>
                    </h3>
                  )}
                  {chapter.introNode.summary && <p class="lead">{chapter.introNode.summary}</p>}

                  <section class="handbook-object__block">
                    <h4>Begrip</h4>
                    {chapter.introNode.entry.data.definition && <p>{chapter.introNode.entry.data.definition}</p>}
                    {chapter.introNode.entry.data.definitionSource && (
                      <p class="handbook-object__source">{chapter.introNode.entry.data.definitionSource}</p>
                    )}
                    {(chapter.introNode.entry.data.terms || []).length > 0 && (
                      <div>
                        <h5>Gerelateerde begrippen</h5>
                        <ul>
                          {(chapter.introNode.entry.data.terms || []).map((term: any) => (
                            <li>
                              <strong>{term.title}</strong>
                              {term.text && <span> {term.text}</span>}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {(chapter.introNode.entry.data.definitionTypes || []).length > 0 && (
                      <div>
                        <h5>Typen naar definitie</h5>
                        <ul>
                          {(chapter.introNode.entry.data.definitionTypes || []).map((definitionType: any) => (
                            <li>
                              <strong>{definitionType.title}</strong>
                              {definitionType.text && <span> {definitionType.text}</span>}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </section>

                  {chapter.introNode.sections.length > 0 && (
                    <section class="handbook-object__block">
                      <h4>Uitwerking</h4>
                      {chapter.introNode.sections.map((section: any) => (
                        <section class="handbook-object__subsection">
                          <h5>{section.title}</h5>
                          {section.summary && <p>{section.summary}</p>}
                          {section.image?.src && (
                            <figure class="handbook-object__figure">
                              <img
                                class="handbook-object__image"
                                src={withBase(section.image.src)}
                                alt={section.image.alt || ""}
                                loading="lazy"
                                decoding="async"
                                fetchpriority="low"
                              />
                              {section.caption && <figcaption class="handbook-object__caption">{section.caption}</figcaption>}
                            </figure>
                          )}
                          {(section.blocks || []).map((block: any) => (
                            <>
                              {block.text && <p>{block.text}</p>}
                              {block.image?.src && (
                                <figure class="handbook-object__figure">
                                  <img
                                    class="handbook-object__image"
                                    src={withBase(block.image.src)}
                                    alt={block.image.alt || ""}
                                    loading="lazy"
                                    decoding="async"
                                    fetchpriority="low"
                                  />
                                  {block.caption && <figcaption class="handbook-object__caption">{block.caption}</figcaption>}
                                </figure>
                              )}
                            </>
                          ))}
                          {(section.items || []).length > 0 && (
                            <div class="card-grid card-grid--nested handbook-object__item-grid">
                              {section.items.map((sectionItem: any) => {
                                const SectionItemTag = sectionItem.href ? "a" : "article";

                                return (
                                <SectionItemTag
                                  class:list={[
                                    "info-card",
                                    "handbook-object__item-card",
                                    sectionItem.image?.src && "info-card--with-image"
                                  ]}
                                  href={sectionItem.href ? withBase(sectionItem.href) : undefined}
                                >
                                  <strong class="handbook-object__item-title">{sectionItem.title}</strong>
                                  {sectionItem.text && <p>{sectionItem.text}</p>}
                                  {sectionItem.image?.src && (
                                    <figure class="handbook-object__figure">
                                      <img
                                        class="handbook-object__image"
                                        src={withBase(sectionItem.image.src)}
                                        alt={sectionItem.image.alt || ""}
                                        loading="lazy"
                                        decoding="async"
                                        fetchpriority="low"
                                      />
                                      {sectionItem.caption && (
                                        <figcaption class="handbook-object__caption">{sectionItem.caption}</figcaption>
                                      )}
                                    </figure>
                                  )}
                                  {(sectionItem.blocks || []).map((block: any) => (
                                    <>
                                      {block.text && <p>{block.text}</p>}
                                      {block.image?.src && (
                                        <figure class="handbook-object__figure">
                                          <img
                                            class="handbook-object__image"
                                            src={withBase(block.image.src)}
                                            alt={block.image.alt || ""}
                                            loading="lazy"
                                            decoding="async"
                                            fetchpriority="low"
                                          />
                                          {block.caption && (
                                            <figcaption class="handbook-object__caption">{block.caption}</figcaption>
                                          )}
                                        </figure>
                                      )}
                                    </>
                                  ))}
                                </SectionItemTag>
                              )})}
                            </div>
                          )}
                        </section>
                      ))}
                    </section>
                  )}
                </div>
              )}
            </header>

            {chapter.flatNodes.map((item) => {
              const entry = item.entry;

              return (
                <article
                  class:list={[
                    "section-panel",
                    "handbook-object",
                    `handbook-object--depth-${Math.min(item.depth, 4)}`
                  ]}
                  id={item.id}
                  style={`--handbook-level: ${Math.min(item.depth - 1, 3)};`}
                >
                  <p class="eyebrow">Paragraaf {item.number}</p>
                  <h3>
                    <span class="handbook-number">{item.number}</span>
                    <span>{item.title}</span>
                  </h3>
                  {item.summary && <p class="lead">{item.summary}</p>}

                  {entry ? (
                    <>
                      <section class="handbook-object__block">
                        <h4>Begrip</h4>
                        {entry.data.definition && <p>{entry.data.definition}</p>}
                        {entry.data.definitionSource && (
                          <p class="handbook-object__source">{entry.data.definitionSource}</p>
                        )}
                        {(entry.data.terms || []).length > 0 && (
                          <div>
                            <h5>Gerelateerde begrippen</h5>
                            <ul>
                              {(entry.data.terms || []).map((term: any) => (
                                <li>
                                  <strong>{term.title}</strong>
                                  {term.text && <span> {term.text}</span>}
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                        {(entry.data.definitionTypes || []).length > 0 && (
                          <div>
                            <h5>Typen naar definitie</h5>
                            <ul>
                              {(entry.data.definitionTypes || []).map((definitionType: any) => (
                                <li>
                                  <strong>{definitionType.title}</strong>
                                  {definitionType.text && <span> {definitionType.text}</span>}
                                </li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </section>

                      {item.sections.length > 0 && (
                        <section class="handbook-object__block">
                          <h4>Uitwerking</h4>
                          {item.sections.map((section: any) => (
                            <section class="handbook-object__subsection">
                              <h5>{section.title}</h5>
                              {section.summary && <p>{section.summary}</p>}
                              {section.image?.src && (
                                <figure class="handbook-object__figure">
                                  <img
                                    class="handbook-object__image"
                                    src={withBase(section.image.src)}
                                    alt={section.image.alt || ""}
                                    loading="lazy"
                                    decoding="async"
                                    fetchpriority="low"
                                  />
                                  {section.caption && <figcaption class="handbook-object__caption">{section.caption}</figcaption>}
                                </figure>
                              )}
                              {(section.blocks || []).map((block: any) => (
                                <>
                                  {block.text && <p>{block.text}</p>}
                                  {block.image?.src && (
                                    <figure class="handbook-object__figure">
                                      <img
                                        class="handbook-object__image"
                                        src={withBase(block.image.src)}
                                        alt={block.image.alt || ""}
                                        loading="lazy"
                                        decoding="async"
                                        fetchpriority="low"
                                      />
                                      {block.caption && <figcaption class="handbook-object__caption">{block.caption}</figcaption>}
                                    </figure>
                                  )}
                                </>
                              ))}
                              {(section.items || []).length > 0 && (
                                <div class="card-grid card-grid--nested handbook-object__item-grid">
                                  {section.items.map((sectionItem: any) => {
                                    const SectionItemTag = sectionItem.href ? "a" : "article";

                                    return (
                                    <SectionItemTag
                                      class:list={[
                                        "info-card",
                                        "handbook-object__item-card",
                                        sectionItem.image?.src && "info-card--with-image"
                                      ]}
                                      href={sectionItem.href ? withBase(sectionItem.href) : undefined}
                                    >
                                      <strong class="handbook-object__item-title">{sectionItem.title}</strong>
                                      {sectionItem.text && <p>{sectionItem.text}</p>}
                                      {sectionItem.image?.src && (
                                        <figure class="handbook-object__figure">
                                          <img
                                            class="handbook-object__image"
                                            src={withBase(sectionItem.image.src)}
                                            alt={sectionItem.image.alt || ""}
                                            loading="lazy"
                                            decoding="async"
                                            fetchpriority="low"
                                          />
                                          {sectionItem.caption && (
                                            <figcaption class="handbook-object__caption">{sectionItem.caption}</figcaption>
                                          )}
                                        </figure>
                                      )}
                                      {(sectionItem.blocks || []).map((block: any) => (
                                        <>
                                          {block.text && <p>{block.text}</p>}
                                          {block.image?.src && (
                                            <figure class="handbook-object__figure">
                                              <img
                                                class="handbook-object__image"
                                                src={withBase(block.image.src)}
                                                alt={block.image.alt || ""}
                                                loading="lazy"
                                                decoding="async"
                                                fetchpriority="low"
                                              />
                                              {block.caption && (
                                                <figcaption class="handbook-object__caption">{block.caption}</figcaption>
                                              )}
                                            </figure>
                                          )}
                                        </>
                                      ))}
                                    </SectionItemTag>
                                  )})}
                                </div>
                              )}
                            </section>
                          ))}
                        </section>
                      )}
                    </>
                  ) : (
                    item.text && item.text !== item.summary && (
                      <section class="handbook-object__block">
                        <h4>Korte omschrijving</h4>
                        <p>{item.text}</p>
                      </section>
                    )
                  )}
                </article>
              );
            })}
          </section>
        ))}
      </div>
    </div>
  )}
</BaseLayout>

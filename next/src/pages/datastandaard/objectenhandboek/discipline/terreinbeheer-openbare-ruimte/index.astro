---
import ObjectenhandboekChapterPage from "../../../../../components/ObjectenhandboekChapterPage.astro";
import { getCollection } from "astro:content";
import { getDisciplineScopes } from "../../../../../lib/objectenhandboekHandbooks";
import {
  createDisciplineChapterEntry,
  TERRAIN_DISCIPLINE_ID
} from "../../../../../lib/objectenhandboekDisciplineChapters";

const scope = getDisciplineScopes().find((item) => item.id === TERRAIN_DISCIPLINE_ID);

if (!scope) {
  throw new Error("Objectenhandboek Terreinbeheer en openbare ruimte ontbreekt in de disciplineconfiguratie.");
}

const entries = await getCollection("datastandaard-objectenhandboek-objects");
const disciplineEntry = createDisciplineChapterEntry(scope, entries);
---

<ObjectenhandboekChapterPage
  entry={disciplineEntry}
  subjectLabel={scope.label}
  handbookHref={scope.href}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Datastandaard", href: "/datastandaard" },
    { label: "Objectenhandboek", href: "/datastandaard/objectenhandboek" },
    { label: scope.label }
  ]}
/>

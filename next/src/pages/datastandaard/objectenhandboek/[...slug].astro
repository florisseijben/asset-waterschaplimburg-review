---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/Hero.astro";
import ConceptSummarySection from "../../../components/ConceptSummarySection.astro";
import PlaceholderStatus from "../../../components/PlaceholderStatus.astro";
import InfoCard from "../../../components/InfoCard.astro";
import UitwerkingSection from "../../../components/UitwerkingSection.astro";
import { createObjectRouteBreadcrumbs } from "../../../lib/objectenhandboekBreadcrumbs";
import { objectTypePlaceholderRoutes } from "../../../lib/objectTypeRoutes";
import { getRaakvlakSectionForObjectTitle } from "../../../lib/objectRaakvlakken";

export function getStaticPaths() {
  const prefix = "/datastandaard/objectenhandboek/";

  return objectTypePlaceholderRoutes.map((page) => ({
    params: { slug: page.href.replace(prefix, "") },
    props: { page }
  }));
}

const { page } = Astro.props;
const parentTitle = page.parentTitle || "Objectenhandboek";
const parentHref = page.parentHref || "/datastandaard/objectenhandboek";
const summary =
  page.summary ||
  `Op deze objecttypepagina vind je straks de definitie, afbakening, samenhang, geometrie en vastleggingsafspraken voor ${page.title}.`;
const hasConceptSummary = Boolean(page.definition || (page.relatedTerms || []).length);
const raakvlakSection = getRaakvlakSectionForObjectTitle(page.title);
---

<BaseLayout
  title={page.title}
  currentPath="/datastandaard"
  breadcrumbs={createObjectRouteBreadcrumbs(page)}
>
  <Hero eyebrow="Objectenhandboek objecttype" title={page.title} summary={summary} />

  {hasConceptSummary && (
    <ConceptSummarySection
      subjectLabel={page.title}
      definition={page.definition}
      definitionSource={page.definitionSource}
      relatedTerms={page.relatedTerms || []}
    />
  )}

  <PlaceholderStatus
    title={`${page.title} volgt in een volgende uitwerkingsslag`}
    summary="Deze kaart verwijst alvast naar een objecttypepagina binnen het Objectenhandboek, zodat objecttypen en subtypen niet naar het woordenboek hoeven te verwijzen."
    scope={`de objecttypepagina voor ${page.title}`}
  />

  {raakvlakSection && (
    <UitwerkingSection
      title={`Inhoudelijke opbouw van ${page.title}`}
      items={[raakvlakSection]}
    />
  )}

  <section class="section section-panel">
    <p class="eyebrow">Bovenliggend object</p>
    <h2>Werk verder vanuit {parentTitle}</h2>
    <InfoCard
      title={parentTitle}
      text={`Bekijk de bovenliggende objectlijn waar ${page.title} onderdeel van is.`}
      href={parentHref}
    />
  </section>
</BaseLayout>

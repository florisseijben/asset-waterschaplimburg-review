---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import Hero from "../../../../../components/Hero.astro";
import HandbookHeroCard from "../../../../../components/HandbookHeroCard.astro";
import ConceptSummarySection from "../../../../../components/ConceptSummarySection.astro";
import ObjectClassificationSection from "../../../../../components/ObjectClassificationSection.astro";
import SemanticSamenhangSection from "../../../../../components/SemanticSamenhangSection.astro";
import ProductSection from "../../../../../components/ProductSection.astro";
import UitwerkingSection from "../../../../../components/UitwerkingSection.astro";
import GeometrySection from "../../../../../components/GeometrySection.astro";
import VervolgSection from "../../../../../components/VervolgSection.astro";
import { getCollection } from "astro:content";
import { getObjectHandbookHref } from "../../../../../lib/objectenhandboekHandbooks";
import {
  createWatergangSamenhangFromAssetJson,
  getConceptFromAssetJson,
  getDecompositionFromAssetJson
} from "../../../../../lib/assetConcepts";
import { getGeometrySection, normalizeObjectUitwerkingSections } from "../../../../../lib/uitwerkingSections";
import { createWatergangGraph } from "../../../../../lib/semanticSamenhangGraphs";

const entries = await getCollection("datastandaard-objectenhandboek-objects");
const expectedSlug = "/datastandaard/objectenhandboek/watersysteem/watergangen";
const entry = entries.find(
  (item) =>
    item.id === "watergangen" ||
    item.data.slug === expectedSlug ||
    item.data.title === "Watergang"
);

if (!entry) {
  throw new Error("Objectenhandboek Watergangen ontbreekt in de nieuwe omgeving.");
}

const conceptData = getConceptFromAssetJson("Watergang");
const decompositionData = getDecompositionFromAssetJson("Watergang");
const samenhangData = createWatergangSamenhangFromAssetJson();
const normalizeTitle = (value: string) => String(value || "").trim().toLowerCase();
const mergeTermItems = (...itemGroups: any[][]) => {
  const seen = new Set<string>();

  return itemGroups.flatMap((items) => items || []).filter((item) => {
    const key = normalizeTitle(item.title);

    if (!key || seen.has(key)) {
      return false;
    }

    seen.add(key);
    return true;
  });
};
const relatedTerms = mergeTermItems(conceptData?.relatedTerms || [], entry.data.terms || []);
const definitionTypes = mergeTermItems(conceptData?.types || [], entry.data.definitionTypes || []);
const mergeContentItemMedia = (derivedItems: any[] = [], contentItems: any[] = []) => {
  const contentItemsByTitle = new Map(contentItems.map((item) => [normalizeTitle(item.title), item]));
  const derivedItemsByTitle = new Map(derivedItems.map((item) => [normalizeTitle(item.title), item]));
  const orderedDerivedItems = contentItems.length
    ? [
        ...contentItems
          .map((item) => derivedItemsByTitle.get(normalizeTitle(item.title)))
          .filter(Boolean),
        ...derivedItems.filter((item) => !contentItemsByTitle.has(normalizeTitle(item.title)))
      ]
    : derivedItems;

  return orderedDerivedItems.map((item) => {
    const contentItem = contentItemsByTitle.get(normalizeTitle(item.title));

    if (!contentItem) {
      return item;
    }

    return {
      ...item,
      image: contentItem.image || item.image,
      caption: contentItem.caption || item.caption
    };
  });
};
const visibleContentSections = (entry.data.contentSections || [])
  .filter((item) => item.title !== "Decompositie")
  .map((item) =>
    item.title === "Onderdelen" && decompositionData
      ? {
          ...item,
          summary: decompositionData.summary,
          items: mergeContentItemMedia(decompositionData.items, item.items)
        }
      : item
  );
const normalizedContentSections = normalizeObjectUitwerkingSections(visibleContentSections, {
  compositionTypes: entry.data.compositionTypes || [],
  subtypeIconTitle: entry.data.heroTitle || entry.data.title
});
const geometrySection = getGeometrySection(visibleContentSections);
const fallbackGraph = createWatergangGraph();
const fallbackSamenhang = {
  sourceLabel: "Dummy relatiebron uit de Watergang-pagina.",
  turtle: `@prefix object: <https://data.waterschaplimburg.nl/id/objecttype/> .
@prefix relatie: <https://data.waterschaplimburg.nl/def/relatie/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

object:watergang a owl:Class ;
  rdfs:label "Watergang" .

object:watergangsectie a owl:Class ;
  rdfs:label "Watergangsectie" .

object:intersectie a owl:Class ;
  rdfs:label "Intersectie" .

relatie:heeftSectie a owl:ObjectProperty ;
  rdfs:label "Heeft sectie" .

relatie:heeftIntersectie a owl:ObjectProperty ;
  rdfs:label "Heeft intersectie" .

object:watergang relatie:heeftSectie object:watergangsectie .
object:watergang relatie:heeftIntersectie object:intersectie .
`,
  layoutNodes: fallbackGraph.layoutNodes,
  edges: fallbackGraph.edges
};
---

<BaseLayout
  title={entry.data.title}
  currentPath="/datastandaard"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Datastandaard", href: "/datastandaard" },
    { label: "Objectenhandboek", href: "/datastandaard/objectenhandboek" },
    { label: "Watersysteem", href: "/datastandaard/objectenhandboek/watersysteem" },
    { label: "Watergangen" }
  ]}
>
  <Hero eyebrow="Objectenhandboek" title={entry.data.heroTitle || entry.data.title} summary={entry.data.summary}>
    <HandbookHeroCard slot="aside" href={getObjectHandbookHref(entry.id)} />
  </Hero>

  <div class="detail-stack">
    <ConceptSummarySection
      subjectLabel="Watergang"
      definition={conceptData?.definition || entry.data.definition}
      synonyms={conceptData?.synonyms || []}
      relatedTerms={relatedTerms}
      definitionTypes={definitionTypes}
    />

    <SemanticSamenhangSection
      title="Decompositie binnen de objectlijn"
      summary="Deze samenhangsweergave laat zien hoe Watergang, Watergangsectie en Intersectie zich tot elkaar verhouden op basis van de ontologische relaties in de dummy begrippen- en objectbron."
      sourceLabel={(samenhangData || fallbackSamenhang).sourceLabel}
      graphId="watergang-samenhang"
      selectedId="watergang"
      turtle={(samenhangData || fallbackSamenhang).turtle}
      layoutNodes={(samenhangData || fallbackSamenhang).layoutNodes}
      edges={(samenhangData || fallbackSamenhang).edges}
    />
  </div>

  <UitwerkingSection title="Inhoudelijke opbouw van Watergang" items={normalizedContentSections} />

  <GeometrySection section={geometrySection} />

  <ProductSection eyebrow="Productlijn" items={entry.data.productRelations || []} />

  <VervolgSection title="Logische volgende stappen binnen deze lijn" items={entry.data.nextSteps || []} />

  <ObjectClassificationSection classification={entry.data.classification} />
</BaseLayout>

---
import ObjectDetailPage from "../../../../../../components/ObjectDetailPage.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("datastandaard-objectenhandboek-objects");
const entry = entries.find((item) => item.id === "aandrijving-en-bewegingswerk" || item.id === "aandrijving-en-bewegingswerk.md");

if (!entry) {
  throw new Error("Objectenhandboekpagina ontbreekt voor Aandrijving en bewegingswerk.");
}
---

<ObjectDetailPage entry={entry} />

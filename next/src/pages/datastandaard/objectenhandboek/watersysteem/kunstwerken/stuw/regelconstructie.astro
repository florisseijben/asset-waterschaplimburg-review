---
import ObjectDetailPage from "../../../../../../components/ObjectDetailPage.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("datastandaard-objectenhandboek-objects");
const entry = entries.find((item) => item.id === "regelconstructie" || item.id === "regelconstructie.md");

if (!entry) {
  throw new Error("Objectenhandboekpagina ontbreekt voor Regelconstructie.");
}
---

<ObjectDetailPage
  entry={entry}
  breadcrumbTrail={[
    { label: "Watersysteem", href: "/datastandaard/objectenhandboek/watersysteem" },
    { label: "Stroomgebied", href: "/datastandaard/objectenhandboek/watersysteem/stroomgebied" },
    { label: "Kunstwerk", href: "/datastandaard/objectenhandboek/watersysteem/kunstwerken" },
    { label: "Stuw", href: "/datastandaard/objectenhandboek/watersysteem/kunstwerken/stuw" },
    { label: "Regelconstructie" }
  ]}
/>

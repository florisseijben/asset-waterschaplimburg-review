---
import ObjectDetailPage from "../../../../../../components/ObjectDetailPage.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("datastandaard-objectenhandboek-objects");
const entry = entries.find((item) => item.id === "regelbaarheid" || item.id === "regelbaarheid.md");

if (!entry) {
  throw new Error("Objectenhandboekpagina ontbreekt voor Regelbaarheid.");
}
---

<ObjectDetailPage entry={entry} />

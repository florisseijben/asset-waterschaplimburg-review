---
import { getCollection } from "astro:content";
import WatergangsectieTypePage from "../../../../../../components/WatergangsectieTypePage.astro";

const entries = await getCollection("datastandaard-objectenhandboek-objects");
const expectedSlug = "/datastandaard/objectenhandboek/watersysteem/watergangsectie/lijnvormig-element";
const entry = entries.find(
  (item) =>
    item.data.slug === expectedSlug ||
    item.data.slug?.replace(/\/$/, "") === expectedSlug ||
    item.data.title === "Lijnvormig element"
);

if (!entry) {
  throw new Error("Objectenhandboek Lijnvormig element ontbreekt in de nieuwe omgeving.");
}
---

<WatergangsectieTypePage entry={entry} sectietype="lijnvormig-element" />

---
import { getCollection } from "astro:content";
import WatergangsectieTypePage from "../../../../../../components/WatergangsectieTypePage.astro";

const entries = await getCollection("datastandaard-objectenhandboek-objects");
const expectedSlug = "/datastandaard/objectenhandboek/watersysteem/watergangsectie/holle-weg";
const entry = entries.find(
  (item) =>
    item.data.slug === expectedSlug ||
    item.data.slug?.replace(/\/$/, "") === expectedSlug ||
    item.data.title === "Holle weg"
);

if (!entry) {
  throw new Error("Objectenhandboek Holle weg ontbreekt in de nieuwe omgeving.");
}
---

<WatergangsectieTypePage entry={entry} sectietype="holle-weg" />

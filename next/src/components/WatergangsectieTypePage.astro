---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "./Hero.astro";
import HandbookHeroCard from "./HandbookHeroCard.astro";
import ConceptSummarySection from "./ConceptSummarySection.astro";
import ObjectClassificationSection from "./ObjectClassificationSection.astro";
import SemanticSamenhangSection from "./SemanticSamenhangSection.astro";
import ProductSection from "./ProductSection.astro";
import UitwerkingSection from "./UitwerkingSection.astro";
import VervolgSection from "./VervolgSection.astro";
import { getObjectHandbookHref } from "../lib/objectenhandboekHandbooks";
import { createObjectBreadcrumbs } from "../lib/objectenhandboekBreadcrumbs";
import { normalizeObjectUitwerkingSections } from "../lib/uitwerkingSections";
import { createWatergangsectieTypeGraph } from "../lib/semanticSamenhangGraphs";
import { appendRaakvlakSection } from "../lib/objectRaakvlakken";

interface Props {
  entry: any;
  sectietype: string;
}

const { entry, sectietype } = Astro.props;
const contentSections = appendRaakvlakSection(
  entry.data.contentSections || [],
  entry.data.heroTitle || entry.data.title
);
const visibleContentSections = normalizeObjectUitwerkingSections(contentSections, {
  compositionTypes: entry.data.compositionTypes || [],
  subtypeIconTitle: entry.data.heroTitle || entry.data.title
});
const typeId = String(entry.id || sectietype).replace(/\.md$/, "");
const typeLabel = entry.data.heroTitle || entry.data.title;
const typeTurtleLabel = String(typeLabel).replace(/\\/g, "\\\\").replace(/"/g, '\\"');
const samenhangGraph = createWatergangsectieTypeGraph(typeId, typeLabel);
const samenhangTurtle = `@prefix object: <https://data.waterschaplimburg.nl/id/objecttype/> .
@prefix relatie: <https://data.waterschaplimburg.nl/def/relatie/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

object:watergang a owl:Class ;
  rdfs:label "Watergang" .

object:watergangsectie a owl:Class ;
  rdfs:label "Watergangsectie" .

object:${typeId} a owl:Class ;
  rdfs:label "${typeTurtleLabel}" .

object:dwarsprofiel a owl:Class ;
  rdfs:label "Dwarsprofiel" .

object:profielgrens a owl:Class ;
  rdfs:label "Profielgrens" .

relatie:heeftSectie a owl:ObjectProperty ;
  rdfs:label "Heeft sectie" .

relatie:heeftType a owl:ObjectProperty ;
  rdfs:label "Heeft type" .

relatie:heeftProfiel a owl:ObjectProperty ;
  rdfs:label "Heeft profiel" .

relatie:heeftBegrenzing a owl:ObjectProperty ;
  rdfs:label "Heeft begrenzing" .

object:watergang relatie:heeftSectie object:watergangsectie .
object:watergangsectie relatie:heeftType object:${typeId} .
object:${typeId} relatie:heeftProfiel object:dwarsprofiel .
object:${typeId} relatie:heeftBegrenzing object:profielgrens .
`;
---

<BaseLayout
  title={entry.data.title}
  currentPath="/datastandaard"
  breadcrumbs={createObjectBreadcrumbs(entry)}
>
  <Hero eyebrow="Objectenhandboek" title={typeLabel} summary={entry.data.summary}>
    <HandbookHeroCard slot="aside" href={getObjectHandbookHref(entry.id)} />
  </Hero>

  <ConceptSummarySection
    subjectLabel={typeLabel}
    definition={entry.data.definition}
    definitionSource={entry.data.definitionSource}
    synonyms={entry.data.synonyms || []}
    relatedTerms={entry.data.terms || []}
    definitionTypes={entry.data.definitionTypes || []}
  />

  <SemanticSamenhangSection
    title={`Decompositie en hoofdrelaties binnen ${typeLabel}`}
    summary={`${typeLabel} wordt hier als type van Watergangsectie getoond, met de relatie naar dwarsprofiel en profielgrenzen.`}
    sourceLabel="Dummy Turtle-export uit de semantische modelleertool voor typen naar compositie binnen Watergangsectie."
    graphId={`${typeId}-samenhang`}
    selectedId={typeId}
    turtle={samenhangTurtle}
    layoutNodes={samenhangGraph.layoutNodes}
    edges={samenhangGraph.edges}
  />

  <UitwerkingSection title={`Inhoudelijke opbouw van ${typeLabel}`} items={visibleContentSections} />

  <ProductSection eyebrow="Productlijn" items={entry.data.productRelations || []} />

  <VervolgSection title="Logische volgende stappen binnen deze lijn" items={entry.data.nextSteps || []} />

  <ObjectClassificationSection classification={entry.data.classification} />
</BaseLayout>

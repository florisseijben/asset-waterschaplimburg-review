---
import CardLinkIndicator from "./CardLinkIndicator.astro";
import CardTitleIcon from "./CardTitleIcon.astro";
import ResponsiveContentImage from "./ResponsiveContentImage.astro";
import { withBase } from "../lib/paths";

interface SectionItem {
  title: string;
  text: string;
  href?: string;
  iconTitle?: string;
  image?: SectionImage;
  caption?: string;
  blocks?: SectionBlock[];
}

interface SectionImage {
  src: string;
  alt?: string;
}

interface SectionBlock {
  text?: string;
  image?: SectionImage;
  caption?: string;
}

interface Props {
  title: string;
  text: string;
  href?: string;
  iconTitle?: string;
  items?: SectionItem[];
  itemLayout?: "cards" | "sections";
  image?: SectionImage;
  caption?: string;
  blocks?: SectionBlock[];
}

const { title, text, href, iconTitle, items = [], itemLayout = "cards", image, caption, blocks = [] } = Astro.props;
const hasItems = items.length > 0;
const usesSectionItems = itemLayout === "sections";
const hasImage = Boolean(image?.src);
const Tag = href && !hasItems ? "a" : "article";
---

<Tag
  class:list={["info-card", "info-card--section", hasImage && "info-card--with-image"]}
  href={href && !hasItems ? withBase(href) : undefined}
>
  <div class="info-card__header">
    <div class="info-card__title-wrap">
      {href && !hasItems && <CardTitleIcon title={iconTitle || title} />}
      <h2 class="info-card__title">{title}</h2>
    </div>
    {href && !hasItems && <CardLinkIndicator />}
  </div>
  <p>{text}</p>
  {image?.src && (
    <figure class="info-card__figure">
      <ResponsiveContentImage class="info-card__image" src={image.src} alt={image.alt || ""} />
      {caption && <figcaption class="info-card__caption">{caption}</figcaption>}
    </figure>
  )}

  {blocks.length > 0 && (
    <div class="info-card__blocks">
      {blocks.map((block) => (
        <div class="info-card__block">
          {block.text && <p>{block.text}</p>}
          {block.image?.src && (
            <figure class="info-card__figure">
              <ResponsiveContentImage class="info-card__image" src={block.image.src} alt={block.image.alt || ""} />
              {block.caption && <figcaption class="info-card__caption">{block.caption}</figcaption>}
            </figure>
          )}
        </div>
      ))}
    </div>
  )}

  {hasItems && usesSectionItems && (
    <div class="info-card__subsections">
      {items.map((item) => (
        <section class:list={["info-card__subsection", item.image?.src && "info-card__subsection--with-image"]}>
          {item.href ? (
            <a class="info-card__subsection-title info-card__subsection-title--link" href={withBase(item.href)}>
              <span>{item.title}</span>
              <CardLinkIndicator />
            </a>
          ) : (
            <h3 class="info-card__subsection-title">{item.title}</h3>
          )}
          <p>{item.text}</p>
          {item.image?.src && (
            <figure class="info-card__figure">
              <ResponsiveContentImage class="info-card__image" src={item.image.src} alt={item.image.alt || ""} />
              {item.caption && <figcaption class="info-card__caption">{item.caption}</figcaption>}
            </figure>
          )}
          {item.blocks && item.blocks.length > 0 && (
            <div class="info-card__blocks">
              {item.blocks.map((block) => (
                <div class="info-card__block">
                  {block.text && <p>{block.text}</p>}
                  {block.image?.src && (
                    <figure class="info-card__figure">
                      <ResponsiveContentImage class="info-card__image" src={block.image.src} alt={block.image.alt || ""} />
                      {block.caption && <figcaption class="info-card__caption">{block.caption}</figcaption>}
                    </figure>
                  )}
                </div>
              ))}
            </div>
          )}
        </section>
      ))}
    </div>
  )}

  {hasItems && !usesSectionItems && (
    <div class="card-grid card-grid--nested">
      {items.map((item) => {
        const ItemTag = item.href ? "a" : "article";
        const hasItemImage = Boolean(item.image?.src);
        return (
        <ItemTag
          class:list={["info-card", "info-card--nested", hasItemImage && "info-card--with-image"]}
          href={item.href ? withBase(item.href) : undefined}
        >
          <div class="info-card__header">
            <div class="info-card__title-wrap">
              {item.href && <CardTitleIcon title={item.iconTitle || item.title} />}
              <h3 class="info-card__title">{item.title}</h3>
            </div>
            {item.href && <CardLinkIndicator />}
          </div>
          <p>{item.text}</p>
          {item.image?.src && (
            <figure class="info-card__figure">
              <ResponsiveContentImage class="info-card__image" src={item.image.src} alt={item.image.alt || ""} />
              {item.caption && <figcaption class="info-card__caption">{item.caption}</figcaption>}
            </figure>
          )}
          {item.blocks && item.blocks.length > 0 && (
            <div class="info-card__blocks">
              {item.blocks.map((block) => (
                <div class="info-card__block">
                  {block.text && <p>{block.text}</p>}
                  {block.image?.src && (
                    <figure class="info-card__figure">
                      <ResponsiveContentImage class="info-card__image" src={block.image.src} alt={block.image.alt || ""} />
                      {block.caption && <figcaption class="info-card__caption">{block.caption}</figcaption>}
                    </figure>
                  )}
                </div>
              ))}
            </div>
          )}
        </ItemTag>
      )})}
    </div>
  )}
</Tag>

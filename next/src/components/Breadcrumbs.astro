---
import { withBase } from "../lib/paths";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

function normalizeBreadcrumbHref(href?: string) {
  const normalizedHref = String(href || "").trim();

  if (
    !normalizedHref ||
    normalizedHref === "undefined" ||
    normalizedHref === "null" ||
    normalizedHref.startsWith("#") ||
    /^(?:[a-z][a-z0-9+.-]*:)?\/\//i.test(normalizedHref)
  ) {
    return normalizedHref || undefined;
  }

  const match = normalizedHref.match(/^([^?#]*)([?#].*)?$/);
  const pathname = match?.[1] || normalizedHref;
  const suffix = match?.[2] || "";

  if (!pathname || pathname === "/" || pathname.endsWith("/") || /\.[^/]+$/.test(pathname)) {
    return normalizedHref;
  }

  return `${pathname}/${suffix}`;
}
---

<nav aria-label="Breadcrumb" class="breadcrumb-nav">
  <ol class="breadcrumb">
    {items.map((item) => {
      const href = normalizeBreadcrumbHref(item.href);

      return (
        <li>
          {href ? <a href={withBase(href)}>{item.label}</a> : <span>{item.label}</span>}
        </li>
      );
    })}
  </ol>
</nav>

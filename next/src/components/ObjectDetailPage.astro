---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "./Hero.astro";
import HandbookHeroCard from "./HandbookHeroCard.astro";
import ConceptSummarySection from "./ConceptSummarySection.astro";
import ObjectClassificationSection from "./ObjectClassificationSection.astro";
import ProductSection from "./ProductSection.astro";
import UitwerkingSection from "./UitwerkingSection.astro";
import VervolgSection from "./VervolgSection.astro";
import { getObjectHandbookHref } from "../lib/objectenhandboekHandbooks";
import { createObjectBreadcrumbs } from "../lib/objectenhandboekBreadcrumbs";
import { normalizeObjectUitwerkingSections } from "../lib/uitwerkingSections";

interface Props {
  entry: {
    id: string;
    data: Record<string, any>;
  };
  breadcrumbTrail?: {
    label: string;
    href?: string;
  }[];
}

const { entry, breadcrumbTrail } = Astro.props;
const currentPath = Astro.url.pathname;
const normalizePath = (value: string) => {
  let path = String(value || "").split(/[?#]/)[0] || "/";
  const base = String(import.meta.env.BASE_URL || "/").replace(/\/+$/g, "");

  if (base && base !== "/" && (path === base || path.startsWith(`${base}/`))) {
    path = path.slice(base.length) || "/";
  }

  return path.replace(/\/+$/g, "") || "/";
};
const legacyRegelconstructieBase = "/datastandaard/objectenhandboek/watersysteem/kunstwerken/stuw/regelconstructie";
const routePath = normalizePath(currentPath);
const constructieSlugByTitle = new Map([
  ["Balgconstructie", "balgconstructie"],
  ["Klepconstructie", "klepconstructie"],
  ["Schotbalkconstructie", "schotbalkconstructie"],
  ["Schuifconstructie", "schuifconstructie"]
]);
const isLegacyRegelconstructieRoute =
  routePath === legacyRegelconstructieBase || routePath.startsWith(`${legacyRegelconstructieBase}/`);
const compositionTypes = isLegacyRegelconstructieRoute
  ? (entry.data.compositionTypes || []).map((item) => {
      const slug = constructieSlugByTitle.get(item.title);

      return slug
        ? {
            ...item,
            href: `${legacyRegelconstructieBase}/${slug}`
          }
        : item;
    })
  : entry.data.compositionTypes || [];
const contentSections = entry.data.contentSections || [];
const uitwerkingSections = normalizeObjectUitwerkingSections(contentSections, {
  compositionTypes,
  subtypeIconTitle: entry.data.heroTitle || entry.data.title
});
---

<BaseLayout
  title={entry.data.title}
  currentPath="/datastandaard"
  breadcrumbs={createObjectBreadcrumbs(entry, {
    currentPath,
    routeTrail: breadcrumbTrail
  })}
>
  <Hero eyebrow="Objectenhandboek" title={entry.data.heroTitle || entry.data.title} summary={entry.data.summary}>
    <HandbookHeroCard slot="aside" href={getObjectHandbookHref(entry.id)} />
  </Hero>

  <ConceptSummarySection
    subjectLabel={entry.data.title}
    definition={entry.data.definition}
    definitionSource={entry.data.definitionSource}
    synonyms={entry.data.synonyms || []}
    relatedTerms={entry.data.terms || []}
    conceptVideos={entry.data.conceptVideos || []}
    definitionTypes={entry.data.definitionTypes || []}
  />

  <UitwerkingSection
    title={`Inhoudelijke opbouw van ${entry.data.title}`}
    items={uitwerkingSections}
  />

  <ProductSection eyebrow="Productlijn" items={entry.data.productRelations || []} />

  <VervolgSection title="Logische volgende stappen binnen deze lijn" items={entry.data.nextSteps || []} />

  <ObjectClassificationSection classification={entry.data.classification} />
</BaseLayout>
